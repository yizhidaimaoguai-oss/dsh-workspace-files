{
  "name": "dsh-workspace-files-project",
  "version": "1.0.0",
  "private": true,
  "description": "DSH workspace file plugin and desktop VSCode HTTP filesystem extension",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "test:portable": "node scripts/test.mjs --portable",
    "test:server": "node scripts/test.mjs --server",
    "package": "node scripts/package.mjs",
    "patch:check": "node scripts/patch-dsh.mjs --check"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
