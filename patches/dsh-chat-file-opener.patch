+it('routes produced files and authored destinations to the browser opener with the owning Session', async () => {
+  const b = await bench()
+  const open = vi.fn(async (_sessionId: SessionId, _path: string) => {})
+  b.runtime.ctx.provide('chatWorkspaceOpener', { accepts: value => value.startsWith('src/'), open })
+  const { injected } = b.chatViewApi(ROOT)
+  await injected.openFile('src/a.ts')
+  expect(open).toHaveBeenCalledWith(ROOT, 'src/a.ts')
+  expect(b.openWorkspacePath).not.toHaveBeenCalled()
